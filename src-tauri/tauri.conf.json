{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMPINVT UI",
  "version": "0.19.0",
  "identifier": "com.cinderblock.ampinvt-ui",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AMPINVT Inverter",
        "width": 1120,
        "height": 840,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/cinderblock/ampinvt-ui/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdENzcyMzhERjA4OTI1NDAKUldSQUpZbndqU04zZlhOY2poenVuL2w0S1BGOFN6c3o4OHk1YVpleEtNZkVSYzNMTXRGTzNpUEYK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
